# career-ops — Environment Variables
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# Never commit .env. Each person needs their own keys.

# ── Gemini Integration ───────────────────────────────────────────────────────
# Required for: node gemini-eval.mjs "JD text here"
# Free API key: https://aistudio.google.com/apikey
# Free tier: 15 RPM / 1M tokens/day with gemini-2.5-flash (no billing needed)
GEMINI_API_KEY=your_gemini_api_key_here
AI_PROVIDER=gemini
# GEMINI_MODEL=gemini-2.5-flash

# ── Groq Integration (optional alternative evaluator) ────────────────────────
# Free API key: https://console.groq.com/keys
# GROQ_API_KEY=your_groq_api_key_here
# AI_MODEL=llama-3.3-70b-versatile

# ── SerpAPI (optional, LinkedIn X-Ray / lead lookup) ─────────────────────────
# https://serpapi.com/
# SERPAPI_KEY=your_serpapi_key_here

# ── Gmail SMTP (optional, cold outreach send) ────────────────────────────────
# Use a Gmail App Password, not your normal login password:
# https://myaccount.google.com/apppasswords
# GMAIL_SENDER_EMAIL=you@gmail.com
# GMAIL_APP_PASSWORD=your_gmail_app_password

# ── Personal details for outreach drafts (optional) ──────────────────────────
# SENDER_NAME=Your Name
# SENDER_ROLE=Full Stack / Backend Engineer
# SENDER_EXP=1.5 years
# SENDER_LINKEDIN=https://www.linkedin.com/in/your-handle
# SENDER_GITHUB=https://github.com/your-handle
# SENDER_PORTFOLIO=https://your-portfolio.example.com

# ── Web dashboard ────────────────────────────────────────────────────────────
# PORT=3000
